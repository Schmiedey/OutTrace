# Public ExtensionPay product slug. Create the same extension ID at extensionpay.com.
WXT_EXTPAY_EXTENSION_ID=linkscope

# Stripe keys are intentionally not used here. Connect Stripe from ExtensionPay's dashboard.

# Optional, off-by-default aggregate counter receiver. Must be HTTPS and contain
# no query string or embedded credentials. Leave blank for fully local counts.
WXT_USAGE_ENDPOINT=
