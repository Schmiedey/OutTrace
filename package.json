{
  "name": "linkscope",
  "description": "See every site, service, tracker, script, and external domain a webpage connects to.",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:entitlements": "node scripts/check-entitlements.mjs",
    "compile": "tsc --noEmit",
    "prebuild": "npm run check:secrets && npm run check:entitlements",
    "prezip": "npm run check:secrets && npm run check:entitlements",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.8",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cytoscape": "^3.34.2",
    "cytoscape-fcose": "^2.2.0",
    "dexie": "^4.2.1",
    "extpay": "^3.1.2",
    "lucide-react": "^0.544.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.9.4",
    "tailwind-merge": "^3.3.1",
    "tldts": "^7.0.17",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
